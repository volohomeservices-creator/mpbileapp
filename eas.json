{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "production",
        "API_BASE_URL": "https://api.voloapp.in",
        "EXPO_PUBLIC_API_URL": "https://api.voloapp.in",
        "EXPO_PUBLIC_SUPABASE_URL": "https://ruavhqfttentcjtmnlct.supabase.co"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
